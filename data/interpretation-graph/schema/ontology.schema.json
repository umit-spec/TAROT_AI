{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarot-ai.internal/schema/interpretation-graph/ontology.schema.json",
  "title": "Interpretation Graph — Shared Ontology Record Shapes",
  "description": "Reusable definitions for the four card-independent ontology files (user-signals.json, user-goals.json, relationship-types.json, global-guardrails.json). Each ontology file is a JSON array; tools/interpretation-graph/validate_interpretation_graph.py applies the matching $def below to each file by convention (there is no cross-file $ref wiring, the same pattern used by data/cards/*.json against types/card.ts).",
  "$defs": {
    "userSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "allowedSources", "notADiagnosis"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "allowedSources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["explicit-user-selection", "user-confirmed"] }
        },
        "notADiagnosis": { "type": "boolean", "const": true }
      }
    },
    "userGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "relationshipType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "definition", "sentenceTemplate", "avoidCertainty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "sentenceTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "Uses explicit bracket placeholders such as [otherCardName]/[otherCardTheme] — never a live template-engine expression."
        },
        "avoidCertainty": { "type": "string", "minLength": 1 }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "rationale", "severity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "rule": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "const": "block" }
      }
    }
  }
}
